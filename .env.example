# spx-paper-trader — secrets template
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored and must NEVER be committed.

# Schwab developer app credentials (developer.schwab.com)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Optional override
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8080

# Optional: reuse an existing Logicon platform token file instead of
# authenticating separately (export as an environment variable):
# LOGICON_TOKENS_FILE=/path/to/combo-trader-tv/tokens.json
