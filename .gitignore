# secrets — never commit
.env
tokens.json

__pycache__/
*.pyc

# The journal CSVs in data/paper/ are intentionally NOT ignored:
# committing them keeps the paper-test record with the code.

# stocks sandbox: daily-bars cache is rebuilt each session (journal CSVs ARE committed)
data/stocks/cache/
# backtest price history cache (re-downloaded; results in data/stocks/backtests ARE committed)
data/stocks/history/
data/stocks/history_tr/

# crypto / FX / commodities labs: the SQLite journal stays on the hub;
# labs_runner exports every table to data/labs/*.csv, and THOSE are committed.
data/labs/*.sqlite
data/labs/*.sqlite-*
